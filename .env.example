# Generate unique high-entropy values; never commit .env.
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# Comma-separated browser origins, e.g. https://ops.example.com
CORS_ORIGINS=

# Pilot integrations. ORBIT only reads Prometheus and records Alertmanager events.
DEPLOYMENT_MODE=pilot
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
ALERTMANAGER_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-secret
